# api-cache-mcp settings
# Copy this file to .env (same folder) and fill in your key.
# .env is listed in .gitignore: never commit it or share it.
# Lines starting with # are comments. Values may be quoted. Changes apply on the next call; no restart needed
# (except MCP_UI_OPEN, which is read at startup).

# Required. Your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for every call. Default: claude-haiku-5-5
# CLAUDE_MODEL=claude-haiku-5-5

# Maximum output tokens per call. Default: 4096
# CLAUDE_MAX_TOKENS=4096

# Prompt cache lifetime: 5m or 1h. Default: 5m (1h costs more to write, lasts longer)
# CLAUDE_CACHE_TTL=5m

# API endpoint. Default: https://api.anthropic.com
# Must be https://, except http://localhost or http://127.0.0.1 for local testing.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Debug page port on localhost. If busy, the next 9 ports are tried. Default: 8765
# The port is only held while the debug window is open, and is picked again each time it opens.
# MCP_UI_PORT=8765

# Open the debug window when the server starts: true or false. Default: true
# MCP_UI_OPEN=true
